# 测试基础设施环境变量模板。
# 复制为 infra/docker/.env.test 后使用（.env.test 被 .gitignore 忽略，不提交）。
#
# 启动测试基础设施：
#   docker compose -f infra/docker/docker-compose.test.yml --env-file infra/docker/.env.test up -d

# PostgreSQL（与开发 5432 / datasetgen 完全隔离）
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=55432
TEST_POSTGRES_DB=datasetgen_test
TEST_POSTGRES_USER=datasetgen_test
TEST_POSTGRES_PASSWORD=datasetgen_test_password

# Redis（与开发 6379 隔离）
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=56379

# MinIO（与开发 9000/9001 隔离）
TEST_MINIO_ENDPOINT=localhost:19000
TEST_MINIO_HOST_PORT=19000
TEST_MINIO_CONSOLE_PORT=19001
TEST_MINIO_ACCESS_KEY=testminioadmin
TEST_MINIO_SECRET_KEY=testminioadmin123
TEST_MINIO_BUCKET_DOCUMENTS=documents-test
TEST_MINIO_BUCKET_OUTPUTS=outputs-test
